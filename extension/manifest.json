{
  "manifest_version": 3,
  "name": "Apple Passwords",
  "version": "0.2.2",
  "description": "Automatically fill iCloud usernames, passwords, email aliases and verification codes.",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": { "id": "icp-linux@local", "strict_min_version": "115.0" }
  },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "action": { "default_popup": "popup.html", "default_title": "Apple Passwords" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
